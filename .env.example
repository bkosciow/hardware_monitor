# Hardware monitor configuration — copy to .env and adjust
HOST=0.0.0.0
PORT=5555
REFRESH_INTERVAL_SECONDS=1

# nvidia-smi executable (NVIDIA)
NVIDIA_SMI_CMD=nvidia-smi

# AMD GPU (Radeon AI PRO R9700) — card auto-detected by PCI vendor; pin if needed:
AMD_GPU_NAME=Radeon AI PRO R9700
#AMD_DRM_CARD=card1

# CPU temperature source — the hwmon *driver name*; ALL hwmons matching it are
# read and the hottest temp*_input wins. Common values:
#   coretemp   Intel CPUs (one hwmon per socket on dual-socket boards) — the default
#   k10temp    AMD CPUs (Family 10h+)
#   acpi_thermal / others: check the name files under /sys/class/hwmon/hwmonN/
CPU_TEMP_HWMON=coretemp

# Filesystems to report free space for (comma-separated mount points)
DISK_PATHS=/,/mnt/rem
