# Hardware monitor configuration — copy to .env and adjust
HOST=0.0.0.0
PORT=5555
REFRESH_INTERVAL_SECONDS=1

# nvidia-smi executable (NVIDIA x4)
NVIDIA_SMI_CMD=nvidia-smi

# AMD GPU (Radeon AI PRO R9700) — card auto-detected by PCI vendor; pin if needed:
AMD_GPU_NAME=Radeon AI PRO R9700
#AMD_DRM_CARD=card1

# CPU temperature source (hwmon name)
CPU_TEMP_HWMON=k10temp
